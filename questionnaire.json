        {
          "id": "emailPlatform",
          "label": "Email Platform",
          "example": "Google Workspace",
          "default": "Google Workspace",
          "type": "text",
          "required": false,
          "ps_token": null,
          "ts_token": "EMAIL_PLATFORM",
